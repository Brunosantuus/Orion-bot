# Copie este arquivo pra ".env" e preencha com valores reais.
# O ".env" nunca é comitado (está no .gitignore) — só este .example.

# ── Telegram ──────────────────────────────────────────────────────────────
TOKEN_ID=
TOKEN_KEY=
TELEGRAM_CHAT_ID=

# ── Groq (IA) ─────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Supabase (deixe em branco pra usar só o fallback local em *.json) ──────
SUPABASE_URL=
SUPABASE_KEY=

# ── Servidor de controle (orion_servidor.py) ───────────────────────────────
# Token do canal celular/Termux (POST /report, GET /commands, POST /ack).
ORION_CTRL_TOKEN=teste-local
# Senha da tela de login do dashboard/chat web.
ORION_WEB_SENHA=teste-local
# Porta do servidor (Render define PORT automaticamente em produção).
ORION_CTRL_PORT=8765

# ── Opcional: integração com o file server do celular ──────────────────────
ORION_SRV_USER=orion
ORION_SRV_PASS=
ORION_ALERT_CHAT_ID=
